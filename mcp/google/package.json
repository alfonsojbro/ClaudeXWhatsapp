{
  "name": "@cxw/mcp-google",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server for Gmail and Calendar.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@cxw/shared": "workspace:*"
  }
}
