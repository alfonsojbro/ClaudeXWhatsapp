{
  "name": "@cxw/scheduler",
  "version": "0.0.1",
  "private": true,
  "description": "Scheduler: routine files, leases, run logs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
