[Unit]
Description=ClaudeXWhatsapp kill-switch sentinel (panic/resume, no LLM)
After=network-online.target cxw-bridge.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cxw
Group=cxw
WorkingDirectory=/srv/cxw/repo
EnvironmentFile=/srv/cxw/cxw.env
Environment=NODE_ENV=production
Environment=HOME=/home/cxw
ExecStart=/usr/local/bin/cxw-ops sentinel
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cxw-sentinel

# hardening (NoNewPrivileges and RestrictSUIDSGID must stay false: this unit calls
# `sudo -n /usr/local/bin/cxw-ctl`, and sudo needs setuid)
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=false
ReadWritePaths=/srv/cxw/data /srv/cxw/state /srv/cxw/repo /home/cxw
UMask=0077

[Install]
WantedBy=multi-user.target
