[Unit]
Description=ClaudeXWhatsapp retention purge (third-party text and media)
After=network-online.target

[Service]
Type=oneshot
User=cxw
Group=cxw
WorkingDirectory=/srv/cxw/repo
EnvironmentFile=/srv/cxw/cxw.env
Environment=NODE_ENV=production
Environment=HOME=/home/cxw
ExecStart=/usr/local/bin/cxw-ops purge
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cxw-purge

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/cxw/data /srv/cxw/state /srv/cxw/repo /home/cxw
UMask=0077

[Install]
WantedBy=multi-user.target
