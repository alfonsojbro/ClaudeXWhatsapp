# /srv/cxw/google.env — root:root 0600. Read by systemd (EnvironmentFile) before
# dropping to user cxw. Generated on the Mac with `pnpm google:auth`; never commit
# the filled-in file — scripts/check-secrets.sh refuses the name `google.env`.
#
#   pnpm google:auth --client-secret ~/Downloads/client_secret_*.json
#   scp google.env root@cxw:/srv/cxw/google.env
#   ssh root@cxw 'chmod 0600 /srv/cxw/google.env && systemctl restart cxw-brain'
#
# The OAuth consent screen must be published to Production. In Testing, Google
# expires refresh tokens after 7 days and the assistant silently loses Gmail and
# Calendar. See docs/RUNBOOK.md section 8.
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME
GOOGLE_REFRESH_TOKEN=CHANGEME
GOOGLE_OWNER_EMAIL=CHANGEME@example.com

# Optional: override the token endpoint (stubs and tests only).
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
