# /srv/cxw/restic.env — root:root 0600. Used by backup.sh and restore.sh.
# Storage Box over SFTP: add to /root/.ssh/config
#   Host storagebox
#     HostName uXXXXXX.your-storagebox.de
#     User uXXXXXX
#     Port 23
#     IdentityFile /root/.ssh/storagebox_ed25519
RESTIC_REPOSITORY=sftp:storagebox:/cxw
RESTIC_PASSWORD=CHANGEME
RESTIC_KEEP_WITHIN=30d
RESTIC_COMPRESSION=auto
