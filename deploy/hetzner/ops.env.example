# append these to /srv/cxw/cxw.env (install-ops.sh does this)
#
# Phase 7 (ops) configuration. Keys already present in cxw.env.example are NOT repeated here:
# TZ, LOG_LEVEL, CXW_DATA_DIR, CXW_STATE_DIR, CXW_OWNERS_FILE, BRIDGE_HOST/PORT,
# BRAIN_HOST/PORT, CXW_MODEL_FAST, CXW_DISK_LIMIT_PCT, CXW_BACKUP_MAX_AGE_H, CXW_ALERT_CMD.
# Optional secrets are shipped EMPTY, never as a placeholder: an empty value means the
# feature is off, while a committed placeholder would become a real (published) credential
# the moment install-ops.sh appended it. The real file is root:root 0600 and never committed.

# --- paths and binaries -------------------------------------------------------------
CXW_OPS_DB=/srv/cxw/data/ops.sqlite
CXW_OPS_BIN=/usr/local/bin/cxw-ops
CXW_CTL=/usr/local/bin/cxw-ctl
CXW_SUDO=sudo -n

# --- health -------------------------------------------------------------------------
HEALTH_TIMEOUT_MS=5000
CXW_HEAL_RECHECK_S=20
# Anthropic auth: cheap check every run; the deep `claude -p ok` probe at most this often
# (minutes; 0 disables it).
CXW_CLAUDE_AUTH_DEEP_CHECK_MIN=60
CXW_CLAUDE_CREDENTIALS_FILE=/home/cxw/.claude/.credentials.json
CXW_CLAUDE_BIN=claude

# --- google token check -------------------------------------------------------------
CXW_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# set to `off` to skip the google check entirely (check reports ok, detail `disabled`)
CXW_GOOGLE_CHECK=on

# --- bridge auth --------------------------------------------------------------------
# Set only if the bridge requires it; ops sends `Authorization: Bearer <token>` on /send.
# empty = disabled (no Authorization header is sent)
BRIDGE_TOKEN=

# --- alerts -------------------------------------------------------------------------
# empty = first owner from CXW_OWNERS_FILE
CXW_ALERT_WHATSAPP_JID=
CXW_ALERT_REPEAT_MIN=240
CXW_ALERT_AFTER_FAILURES=1
# `live` sends; `log` prints `[alert:<channel>] …` instead (tests and local chaos)
CXW_ALERT_TRANSPORT=live

# Email fallback (used when WhatsApp is the thing that is down). Disabled if SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# empty = disabled
SMTP_PASS=
SMTP_SECURE=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Telegram fallback (last resort).
TELEGRAM_ALERTS=false
# empty = disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- retention ----------------------------------------------------------------------
CXW_RETENTION_TEXT_DAYS=180
CXW_RETENTION_MEDIA_DAYS=90
CXW_RETENTION_OWNER_FOREVER=true
CXW_PURGE_EMERGENCY_MEDIA_DAYS=14
CXW_PURGE_VACUUM=false

# --- costs --------------------------------------------------------------------------
CXW_COST_MONTHLY_CAP_USD=100
CXW_COST_WARN_PCT=80
