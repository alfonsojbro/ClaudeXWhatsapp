# /srv/cxw/cxw.env — root:root 0600. Read by systemd before dropping to user cxw.
# Placeholders only. Never commit the filled-in file.
NODE_ENV=production
TZ=Europe/Prague
LOG_LEVEL=info

# Paths
CXW_DATA_DIR=/srv/cxw/data
CXW_STATE_DIR=/srv/cxw/state
CXW_VAULT_DIR=/srv/cxw/repo/vault
CXW_WORKSPACE_DIR=/srv/cxw/repo/workspace
CXW_OWNERS_FILE=/srv/cxw/state/owners.json

# Internal service addresses (loopback only; never expose)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7411
BRAIN_HOST=127.0.0.1
BRAIN_PORT=7412

# Anthropic auth. Prefer the subscription: run `claude auth login` as cxw, or paste the
# token from `claude setup-token`. ANTHROPIC_API_KEY is the metered fallback.
CLAUDE_CODE_OAUTH_TOKEN=CHANGEME
ANTHROPIC_API_KEY=CHANGEME
CXW_MODEL_MAIN=claude-fable-5-1
CXW_MODEL_FAST=claude-haiku-4-5-20251001

# Optional: Whisper transcription via OpenAI (Phase 3)
OPENAI_API_KEY=CHANGEME

# Monitor
CXW_DISK_LIMIT_PCT=85
CXW_BACKUP_MAX_AGE_H=8
# CXW_ALERT_CMD=/srv/cxw/repo/deploy/hetzner/alert.sh   # Phase 7

# --- Scheduler (Phase 5: routines) -----------------------------------------------------------
# Timezone every routine is scheduled in unless its own frontmatter overrides it. Falls back to
# TZ above, then to Europe/Prague.
CXW_TZ=Europe/Prague
# Scheduler SQLite file. Default: <CXW_DATA_DIR>/scheduler.sqlite
SCHEDULER_DB=/srv/cxw/data/scheduler.sqlite
# Bridge base URL for POST /send and GET /health. When unset it is derived from
# BRIDGE_HOST and BRIDGE_PORT above.
BRIDGE_URL=http://127.0.0.1:7411
# Bearer token for POST /send. Leave unset to send no Authorization header.
BRIDGE_TOKEN=CHANGEME
# Tick cadence and job limits.
SCHEDULER_TICK_MS=60000
MAX_CONCURRENT_JOBS=2
LEASE_TTL_MS=90000
JOB_TIMEOUT_MS=900000
# How often the calendar is polled for meeting-prep triggers, in minutes.
CALENDAR_POLL_MINUTES=5
# Health check: the file the backup job touches, and where alerts go when WhatsApp is down.
# Disk and backup thresholds reuse CXW_DISK_LIMIT_PCT and CXW_BACKUP_MAX_AGE_H above.
CXW_BACKUP_STAMP_FILE=/srv/cxw/state/last-backup
# Leave commented out unless you have a real address: a placeholder value only makes every alert
# fail at Gmail.
# CXW_ALERT_EMAIL_TO=you@example.com
# Google OAuth for the scheduler's own REST calls (health probe, calendar polling, alert mail).
# The LLM routines reach Gmail and Calendar through the `google` MCP instead.
GOOGLE_CLIENT_ID=CHANGEME
GOOGLE_CLIENT_SECRET=CHANGEME
GOOGLE_REFRESH_TOKEN=CHANGEME

# Setup wizard (Phase 10)
# Set to 1 while the browser setup wizard should answer at /setup; the wizard clears it
# when the last step completes. The phase 10 installer writes it here from cloud-init.
CXW_SETUP_MODE=0
