# /srv/cxw/cxw.env — root:root 0600. Read by systemd before dropping to user cxw.
# Placeholders only. Never commit the filled-in file.
NODE_ENV=production
TZ=Europe/Prague
LOG_LEVEL=info

# Paths
CXW_DATA_DIR=/srv/cxw/data
CXW_STATE_DIR=/srv/cxw/state
CXW_VAULT_DIR=/srv/cxw/repo/vault
CXW_WORKSPACE_DIR=/srv/cxw/repo/workspace
CXW_OWNERS_FILE=/srv/cxw/state/owners.json

# Internal service addresses (loopback only; never expose)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7411
BRAIN_HOST=127.0.0.1
BRAIN_PORT=7412

# Anthropic auth. Prefer the subscription: run `claude auth login` as cxw, or paste the
# token from `claude setup-token`. ANTHROPIC_API_KEY is the metered fallback.
CLAUDE_CODE_OAUTH_TOKEN=CHANGEME
ANTHROPIC_API_KEY=CHANGEME
CXW_MODEL_MAIN=claude-fable-5-1
CXW_MODEL_FAST=claude-haiku-4-5-20251001

# Optional: Whisper transcription via OpenAI (Phase 3)
OPENAI_API_KEY=CHANGEME

# Monitor
CXW_DISK_LIMIT_PCT=85
CXW_BACKUP_MAX_AGE_H=8
# CXW_ALERT_CMD=/srv/cxw/repo/deploy/hetzner/alert.sh   # Phase 7

# Setup wizard (Phase 10)
# Set to 1 while the browser setup wizard should answer at /setup; the wizard clears it
# when the last step completes. The phase 10 installer writes it here from cloud-init.
CXW_SETUP_MODE=0
