# Local development copy of deploy/hetzner/cxw.env.example.
# Copy to .env and fill in. Never commit .env (blocked by .gitignore and check-secrets).
NODE_ENV=development
TZ=Europe/Prague
LOG_LEVEL=debug

# Paths (local dev; on the box these live under /srv/cxw)
CXW_DATA_DIR=./data
CXW_STATE_DIR=./state
CXW_VAULT_DIR=./vault
CXW_WORKSPACE_DIR=./workspace
CXW_OWNERS_FILE=./config/owners.json

# Internal service addresses (loopback only)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7411
BRAIN_HOST=127.0.0.1
BRAIN_PORT=7412

# Anthropic auth: subscription token from `claude setup-token`, or an API key as fallback
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CXW_MODEL_MAIN=claude-fable-5-1
CXW_MODEL_FAST=claude-haiku-4-5-20251001

# Optional: Whisper transcription via OpenAI
OPENAI_API_KEY=
